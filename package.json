{
  "name": "dsh-water-reminder",
  "version": "0.1.0",
  "description": "Interval hydration reminders for the DeepSeek Harness Web GUI: a floating water ball, in-page toasts, and system notifications.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "water",
    "hydration",
    "reminder",
    "health"
  ],
  "license": "MIT",
  "author": "zeng5630",
  "homepage": "https://github.com/zeng5630/dsh-water-reminder",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zeng5630/dsh-water-reminder.git"
  },
  "type": "module",
  "main": "lib/index.js",
  "icon": "./icon.svg",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./icon.svg": "./icon.svg"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "icon.svg",
    "preview.png",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  }
}
